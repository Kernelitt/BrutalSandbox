<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- ОПТИМИЗАЦИЯ ДЛЯ СТАБИЛЬНОГО И КОМПАКТНОГО РЕЛИЗА -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>

    <IncludeNativeFmod>true</IncludeNativeFmod>
  </PropertyGroup>

  <!-- АВТОМАТИЧЕСКОЕ КОПИРОВАНИЕ ДИРЕКТОРИЙ ИГРЫ -->
  <ItemGroup>
    <None Update="assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="fonts\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="localizations\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- АВТОМАТИЧЕСКИЙ СБОР И УПАКОВКА ФАЙЛОВ FMOD С ВАШЕГО ДИСКА ПОД ВСЕ ОС -->
  
  <!-- 1. Для Windows (win-x64): забираем fmod.dll -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''">
    <Content Include="C:\Program Files (x86)\FMOD SoundSystem\FMOD Studio API Windows\api\core\lib\x64\fmod.dll" Link="fmod.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PublishState>Included</PublishState>
    </Content>
  </ItemGroup>

  <!-- 2. Для Linux (linux-x64): автоматически забираем libfmod.so из распакованного вами SDK -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Content Include="C:\Program Files (x86)\FMOD SoundSystem\fmodstudioapi20315linux\api\core\lib\x86_64\libfmod.so" Link="libfmod.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PublishState>Included</PublishState>
    </Content>
  </ItemGroup>

  <!-- 3. Для macOS (osx-arm64): автоматически забираем libfmod.dylib из API программиста -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <Content Include="C:\Program Files (x86)\FMOD SoundSystem\FMOD Programmers API\api\core\lib\libfmod.dylib" Link="libfmod.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PublishState>Included</PublishState>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Fmod" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5" />
    <PackageReference Include="Ahwoo.BRUTAL.Gltf" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.FreeType" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ImPlot" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Jolt" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.RakNet" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.ShaderC" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Vma" Version="2026.10.3" />
  </ItemGroup>

</Project>
